{
  "name": "@kairo/landing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0205 next dev --port 3000",
    "build:dashboard": "mkdir -p public/dashboard && rm -rf public/dashboard && cp -r ../dashboard/dist public/dashboard",
    "build": "bun run build:dashboard && next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "rm -rf .next out public/dashboard"
  },
  "dependencies": {
    "@kairo/env": "workspace:*",
    "@kairo/feature-flags": "workspace:*",
    "@kairo/observability": "workspace:*",
    "@kairo/tokens": "workspace:*",
    "@kairo/ui": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.105.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.1.3",
    "googleapis": "^171.4.0",
    "inngest": "^4.3.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.2",
    "@kairo/dashboard": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
