{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairo",
  "version": "0.1.0",
  "identifier": "com.kairo.desktop",
  "build": {
    "beforeDevCommand": "bun run --filter @kairo/dashboard dev",
    "devUrl": "http://127.0.0.1:5173/dashboard/",
    "beforeBuildCommand": "DASHBOARD_BASE_PATH=/ bun run --filter @kairo/dashboard build",
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kairo"]
      }
    }
  }
}
