{
  "$description": "Kairo semantic tokens. Light theme. Every value references core.json.",
  "surface": {
    "page": {
      "$type": "color",
      "$value": "{color.bg}",
      "$description": "App background and ticket pane; public web page background."
    },
    "panel": {
      "$type": "color",
      "$value": "{color.surface}",
      "$description": "Queue, context panel, cards, popovers, secondary buttons."
    },
    "sidebar": {
      "$type": "color",
      "$value": "{color.side}",
