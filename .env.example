# =================================================================
# Kairo — single root .env.local for the entire monorepo
#
# cp .env.example .env.local  (fill in real values, never commit)
#
# How each app reads this file:
#   apps/dashboard — Vite envDir set to "../../" so it reads from here
#   apps/landing — Next.js traverses up to the monorepo root
#
# Validated by packages/env/index.ts (shared) and each app's env.ts.
# Never access process.env or import.meta.env directly — use env.ts.
# =================================================================

# === SHARED (packages/env) =======================================
# Validated for: api, landing (server-side)

# Supabase project URL — server-side usage
SUPABASE_URL=https://your-project.supabase.co

# LLM provider: anthropic | ollama (default: ollama)
INTELLIGENCE_PROVIDER=ollama

# Anthropic API key — required only when INTELLIGENCE_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model override — optional, defaults to claude-sonnet-4-6
# (hardcoded in packages/intelligence/src/providers/anthropic/completion.ts)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Reference: latest Claude Haiku, for a faster/cheaper alternative
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# GOOGLE OAUTH client secret — server-only, NEVER expose to the client
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Tier 1 onboarding fast-path (apps/api/src/functions/pipeline/tier1-fast-path.ts)
# How many of the most recent inbox messages to scan on first Gmail connect.
FAST_PATH_SCAN_SIZE=30
# Minimum relevant classifications before the wizard "Continue" button enables.
# Does NOT cap how many emails Tier 1 classifies — that's FAST_PATH_SCAN_SIZE.
FAST_PATH_CONTINUE_THRESHOLD=3
# Concurrent *runs* of the whole Tier 1 function (e.g. two accounts onboarding
# at the same time) — not concurrent LLM calls within one run.
FAST_PATH_CONCURRENCY=3
# Concurrent classifyEmailWithMeta calls WITHIN a single tier1/tier2/tier3 run.
# Local Ollama has a real ceiling here (OLLAMA_NUM_PARALLEL, usually 1-4 —
# exceeding it queues/timeouts requests); Anthropic's per-minute rate limits
# comfortably absorb much higher values. Keep low for local dev, raise per
# environment once measured, not guessed.
FAST_PATH_LLM_CONCURRENCY=2
# Consecutive classification failures before a run's circuit breaker opens and
# stops attempting new messages for the rest of that run (in-flight ones still
# finish) — the backend is down/saturated, don't burn the rest of the batch on it.
FAST_PATH_CIRCUIT_BREAKER_THRESHOLD=3

# === OBSERVABILITY (KAI-126) ======================================
# Validated for: api (packages/intelligence reads these directly)
# See docs/observability.md to stand up the local stack and get real keys.

# Langfuse (self-hosted, docker-compose.observability.yml) — LLM tracing.
# Unset → tracing is a no-op, classification/embeddings work unaffected.
LANGFUSE_BASE_URL=http://localhost:3003
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ClickStack (HyperDX all-in-one, docker-compose.observability.yml) —
# app observability. Unset → OTel SDK stays disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kairo-api

# --- docker-compose.observability.yml only (NOT read by packages/env) ---
# Required to start the Langfuse containers. Generate with `openssl rand -hex 32`.
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# Optional overrides (compose has safe local-dev defaults otherwise):
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_SECRET=
# LANGFUSE_REDIS_PASSWORD=

# Headless init (KAI-189) — auto-provisions the org/project/user/API-key pair
# on first boot, no manual signup needed. Set these to the SAME values as
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY above (you choose them, they don't
# need to come from Langfuse — any pk-lf-.../sk-lf-... string works).
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=local@kairo.dev
# LANGFUSE_INIT_USER_PASSWORD=

# ClickStack ingestion key (docker-compose.observability.yml only — NOT the
# same as the Personal API access key scripts/observability/hyperdx-dashboard.ts
# needs, which HyperDX doesn't support headless-provisioning; get that one
# from the UI after first signup — Team Settings -> API & Agents).
# HYPERDX_API_KEY=

# === FEATURE FLAGS (packages/feature-flags) =======================
#
# Server-side, boolean (runtime-overrideable):
#   FEATURE_FLAG_<UPPER_SNAKE_NAME>=true|false
#   Defaults: false unless overridden here.
#
# Server-side, numeric (runtime-overrideable):
#   FEATURE_FLAG_<UPPER_SNAKE_NAME>=<positive integer>
#   Defaults: see packages/feature-flags/src/flags.ts. Invalid/unset → default.
#
# Client-side (build-time, Vite/framework-compiled):
#   VITE_FF_<UPPER_SNAKE_NAME>=true|false
#   Defaults: false unless overridden here.
#   Used by SPA clients that can't access process.env at runtime.
#
# Client-side, numeric (build-time, Vite/framework-compiled):
#   VITE_FF_<UPPER_SNAKE_NAME>=<positive integer>
#   Defaults: see apps/dashboard/src/lib/feature-flags.ts. Invalid/unset → default.
#   Baked in at build time — a new value only takes effect on the next deploy.

# KAI-201: show real-time detection UI in the onboarding wizard (step 2)
# When OFF (default): wizard skips detect step → goes straight to company-name form
# When ON: shows live classification metrics polled from /bff/classification/progress
# FEATURE_FLAG_ENABLE_DETECTION_UI=true

# KAI-246: send acknowledgement.html on new ticket creation via outbox
# When OFF (default): customer doesn't get auto-confirmation with ticket number (KAI-T-n)
# When ON: sends "Kairo Support" template immediately on was_created=true, skips out-of-hours reply
# FEATURE_FLAG_ENABLE_TICKET_ACKNOWLEDGEMENT=true

# KAI-248: how often (in minutes) the Gmail history.list poll cron fans out
# one event per active Gmail integration. Default: 5. The cron schedule is
# registered at app startup, so a new value takes effect on the next deploy/restart.
# FEATURE_FLAG_GMAIL_POLL_CRON_INTERVAL_MINUTES=5

# === LANDING (apps/landing) ======================================
# Validated by apps/landing/env.ts via @t3-oss/env-nextjs

# Supabase public vars (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Google OAuth client ID (safe to expose to the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Base URL of the landing/auth app (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where to send users after login — /dashboard in prod, Vite URL in dev
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173/dashboard/

# KAI-126/KAI-189: ClickStack (OpenTelemetry) browser tracing. Unset -> disabled.
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === KELAN (apps/kelan) ============================================
# Validated by apps/kelan/env.ts via @t3-oss/env-nextjs

# Supabase public vars (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — base URL of the kelan app itself
# NEXT_PUBLIC_KELAN_URL=http://localhost:3002

# KAI-126/KAI-189: ClickStack (OpenTelemetry) browser tracing. Unset -> disabled.
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === DASHBOARD (apps/dashboard) ===================================
# Validated by apps/dashboard/src/env.ts via @t3-oss/env-core

# Supabase public vars (Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Landing URL for cross-app redirects — empty in prod (same origin)
VITE_LANDING_URL=http://localhost:3000

# KAI-126: ClickStack (OpenTelemetry) browser tracing (docker-compose.observability.yml).
# Unset -> disabled, no fetch instrumentation registered.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VITE_OTEL_SERVICE_NAME=kairo-dashboard

# Client-side feature flags (build-time, VITE_FF_*)
# These are compiled at build time by Vite and cannot be changed at runtime.
# Default: false (disabled) — uncomment to enable.

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ Dashboard → Right Panel — Triage Ticket Tabs                               ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# Each tab can be independently enabled/disabled. When disabled, the tab does
# not appear in the UI and is not loaded. Default is OFF (false).

# Tab 0: AI Assistant — Copilot chat for ticket resolution (KAI-249)
# VITE_FF_ENABLE_ASSISTANT_TAB=true

# Tab 1: Client Profile — Customer details, contact info, KPIs
# VITE_FF_ENABLE_CLIENT_TAB=true

# Tab 2: Similar Tickets — Semantic search for related resolved cases
# VITE_FF_ENABLE_SIMILAR_TAB=true

# Tab 3: Knowledge Base — Article recommendations from internal KB
# VITE_FF_ENABLE_ARTICLES_TAB=true

# Tab 4: Escalation Flow — Escalation reasons, severity, recommendation (KAI-249)
# VITE_FF_ENABLE_ESCALATE_TAB=true

# Ticket grouping (KAI-24) — triage left panel: multi-select checkboxes,
# "Agrupar seleccionados" action bar, AI similarity suggestion callout and
# the grouped-tickets badge on cards. OFF unless exactly "true"; safe unset.
# VITE_FF_ENABLE_TICKET_GROUPING=true

# Tab order (optional) — comma-separated tab ids, defines display order in the
# tab bar. Does NOT enable/disable anything — only reorders tabs that are
# already enabled above. Any enabled tab not listed here is appended at the
# end, in the order coded in ai-assistant.tsx. Unset → order stays as coded.
# Valid ids: assistant, client, similar, articles, escalate, notes
# VITE_FF_RIGHT_PANEL_TAB_ORDER=client,escalate,assistant

# "Assign to me" button (ticket header) — OFF unless exactly "true"; safe unset.
# VITE_FF_ENABLE_ASSIGN_TO_ME=true

# KAI-177: how often (in seconds) the sidebar polls /api/v1/sidebar/counts for
# the nav badge counts (Triage/Resuelto/etc.). Default: 20. Invalid/unset → default.
# VITE_FF_SIDEBAR_COUNTS_POLL_INTERVAL_SECONDS=20

# Internal notes and @mentions (KAI-232) — gates the ENTIRE internal-notes
# surface: note mode in the reply bar, amber note cards in the thread, the
# right-panel "Notes" tab, the @mention dropdown, and the "@menciones" tab in
# the notification bell. OFF unless exactly "true"; safe unset. The backend
# stays live either way — this only hides the UI.
# VITE_FF_ENABLE_INTERNAL_NOTES=true

# KAI-232: how often (in seconds) the notification bell polls
# /api/v1/notifications. Default: 30. Invalid/unset → default.
# VITE_FF_NOTIFICATIONS_POLL_INTERVAL_SECONDS=30

# === MOBILE (apps/mobile) ==========================================
# No @t3-oss/env setup yet (app is a placeholder) — read via process.env
# directly, using Expo's own EXPO_PUBLIC_* convention for build-time-inlined
# client vars, not this repo's usual env.ts pattern.

# KAI-126: mobile OTel tracing (manual spans only, no auto-instrumentation —
# see packages/observability/src/mobile.ts). Unset -> disabled.
EXPO_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
