# =================================================================
# Kairo — single root .env.local for the entire monorepo
#
# cp .env.example .env.local  (fill in real values, never commit)
#
# How each app reads this file:
#   apps/dashboard — Vite envDir set to "../../" so it reads from here
#   apps/landing — Next.js traverses up to the monorepo root
#
# Validated by packages/env/index.ts (shared) and each app's env.ts.
# Never access process.env or import.meta.env directly — use env.ts.
# =================================================================

# === SHARED (packages/env) =======================================
# Validated for: api, landing (server-side)

# Supabase project URL — server-side usage
SUPABASE_URL=https://your-project.supabase.co

# === MODEL ROUTING (server only; KAI-63) ===========================
# Remote models use the team's own provider key (BYOK) configured in Gateway.
# Gateway retries a failed BYOK request with its system credentials and offers
# no switch to disable that; Kairo logs a warning for each response served that
# way. Configure only models the BYOK key supports.
# All remote inference uses this credential. Never use a VITE_* key.
# AI_GATEWAY_API_KEY=
# Gateway identifiers use provider/model, as listed in its live catalog.
# AI_GATEWAY_MODEL=                         # default generative model
# AI_GATEWAY_TEXT_MODEL=                    # optional text-only default
# AI_GATEWAY_DECISION_MODEL=typesafe-ai/jev  # replace with any native decision model
# Serving providers default to the model owner. Override by model ID or owner:
# AI_GATEWAY_PROVIDER_ROUTES={"moonshotai":["moonshotai"],"typesafe-ai":["typesafe-ai"]}
# Provider restriction does NOT disable Gateway's BYOK-to-system credential fallback.

# Transport defaults: gateway | ollama. Legacy anthropic/jev aliases use Gateway.
INTELLIGENCE_PROVIDER=gateway
# Native typed questions and probabilities: decision. Structured generation: language.
CLASSIFICATION_MODE=decision
TEXT_PROVIDER=gateway
EMBEDDING_PROVIDER=ollama

# Per-role overrides take precedence and select Gateway.
# AI_GATEWAY_CLASSIFICATION_MODEL=          # must match CLASSIFICATION_MODE
# AI_GATEWAY_KNOWLEDGE_DECISION_MODEL=       # native decision capability
# AI_GATEWAY_EVIDENCE_ANALYSIS_MODEL=        # language capability; analyzes evidence before decisions
# AI_GATEWAY_KNOWLEDGE_DRAFT_MODEL=          # language capability
# AI_GATEWAY_VALIDATION_MODEL=              # native decision capability; verifies source support and business context
# AI_GATEWAY_REPLY_MODEL=                    # language capability
# AI_GATEWAY_ASSISTANT_MODEL=                # language capability + tools
# AI_GATEWAY_EMBEDDING_MODEL=                # embedding capability; must produce EMBEDDING_DIMENSIONS

# Ollama is the only local exception: loopback/private LAN, no redirects.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=granite4.1:3b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Dimensions of the embedding model, for every provider. Must equal the database
# vector columns (768); the API refuses to start otherwise. Changing the model
# means migrating the columns and re-embedding, not only this value.
# EMBEDDING_DIMENSIONS=768
# Knowledge retrieval and affected-ticket selection: minimum cosine similarity
# (0.70-0.90) and most tickets evaluated per approved knowledge version.
# EMBEDDING_SIMILARITY_THRESHOLD=0.80
# KNOWLEDGE_CANDIDATE_LIMIT=25

# Optional independent language classifier: gateway:provider/model or ollama:model.
# INTELLIGENCE_ENSEMBLE=
# ================================================================

# GOOGLE OAUTH client secret — server-only, NEVER expose to the client
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Most recent inbox emails Tier 1 reads when an account first connects Gmail.
FAST_PATH_SCAN_SIZE=30
# Emails classified before the wizard enables its continue button. It does not limit how many emails Tier 1 reads.
FAST_PATH_CONTINUE_THRESHOLD=3
# Tier 1 runs that can execute at the same time, for example two accounts connecting together.
FAST_PATH_CONCURRENCY=3
# Classification calls that can run at the same time inside one run. A local model queues or times out requests above its own parallelism, so keep it low there and raise it per environment once measured.
FAST_PATH_LLM_CONCURRENCY=2
# Consecutive classification failures after which a run stops starting new emails. The ones already in flight finish.
FAST_PATH_CIRCUIT_BREAKER_THRESHOLD=3
# Classification attempts an email can accumulate, across the whole pipeline and the retry job, before it is marked as permanently failed.
CLASSIFICATION_MAX_ATTEMPTS=5

# === OBSERVABILITY (KAI-126) ======================================
# Validated for: api (packages/intelligence reads these directly)
# See docs/observability.md to stand up the local stack and get real keys.

# Langfuse (self-hosted, docker-compose.observability.yml) — LLM tracing.
# Unset → tracing is a no-op, classification/embeddings work unaffected.
LANGFUSE_BASE_URL=http://localhost:3003
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ClickStack (HyperDX all-in-one, docker-compose.observability.yml) —
# app observability. Unset → OTel SDK stays disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kairo-api

# --- docker-compose.observability.yml only (NOT read by packages/env) ---
# Required to start the Langfuse containers. Generate with `openssl rand -hex 32`.
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# Optional overrides (compose has safe local-dev defaults otherwise):
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_SECRET=
# LANGFUSE_REDIS_PASSWORD=

# Headless init (KAI-189) — auto-provisions the org/project/user/API-key pair
# on first boot, no manual signup needed. Set these to the SAME values as
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY above (you choose them, they don't
# need to come from Langfuse — any pk-lf-.../sk-lf-... string works).
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=local@kairo.dev
# LANGFUSE_INIT_USER_PASSWORD=

# ClickStack ingestion key (docker-compose.observability.yml only — NOT the
# same as the Personal API access key scripts/observability/hyperdx-dashboard.ts
# needs, which HyperDX doesn't support headless-provisioning; get that one
# from the UI after first signup — Team Settings -> API & Agents).
# HYPERDX_API_KEY=

# === FEATURE FLAGS ================================================
# FEATURE_FLAG_*  server, read at runtime
# VITE_FF_*       dashboard, compiled at build time
# Boolean: exactly "true" turns it on; unset or anything else uses the default shown.
# Number: a positive integer; unset or invalid uses the default shown.

# --- Local development ---
# Use the local Supabase stack
FEATURE_FLAG_LOCAL_SUPABASE=false
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ANON_KEY=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=

# --- Mail intake and classification ---
# Tier 3 classifies the whole inbox in one pass
# FEATURE_FLAG_TIER3_FULL_INBOX=false
# Live progress step in the onboarding wizard
# FEATURE_FLAG_ENABLE_DETECTION_UI=false
# Recompute which ticket types are auto-approved
# FEATURE_FLAG_ENABLE_AUTO_APPROVAL_RECOMPUTE=false
# Minutes between recomputes
# FEATURE_FLAG_AUTO_APPROVAL_RECOMPUTE_INTERVAL_MINUTES=30
# Minutes between retries of failed classifications
# FEATURE_FLAG_CLASSIFICATION_RETRY_SWEEP_CRON_INTERVAL_MINUTES=30
# Minutes between Gmail polls (a change needs a restart)
# FEATURE_FLAG_GMAIL_POLL_CRON_INTERVAL_MINUTES=5

# --- Native decision model (JEV) ---
# Run beside the main classifier and log only
# FEATURE_FLAG_ENABLE_JEV_SHADOW_CLASSIFICATION=false
# Can auto-approve proposals, only for the mailboxes below
# FEATURE_FLAG_ENABLE_JEV_CANARY=false
# Comma-separated mailbox addresses for the canary
# FEATURE_FLAG_JEV_CANARY_MAILBOXES=

# --- Embeddings ---
# FEATURE_FLAG_ENABLE_EMBEDDINGS=true
# FEATURE_FLAG_ENABLE_EMBEDDING_GENERATION=true
# FEATURE_FLAG_ENABLE_EMBEDDING_INDEXING=true
# FEATURE_FLAG_ENABLE_EMBEDDING_RETRIEVAL=true

# --- Knowledge ---
# Propose facts and articles from incoming mail
# FEATURE_FLAG_ENABLE_EMAIL_KNOWLEDGE=false
# Propose an article when a resolved ticket is worth keeping
# FEATURE_FLAG_ENABLE_KNOWLEDGE_CANDIDATES=false

# --- Tickets (server) ---
# Create draft contacts from classified tickets
# FEATURE_FLAG_ENABLE_CONTACT_EXTRACTION=false
# Send the acknowledgement email when a ticket is created
# FEATURE_FLAG_ENABLE_TICKET_ACKNOWLEDGEMENT=false
# Notify when a ticket crosses its priority escalation threshold
# FEATURE_FLAG_ENABLE_OPERATIONAL_SLA_ESCALATION=false
# Minutes between escalation scans
# FEATURE_FLAG_OPERATIONAL_SLA_ESCALATION_CHECK_INTERVAL_MINUTES=5

# --- Dashboard: Sidebar ---
# Whole panel
# VITE_FF_ENABLE_SIDEBAR=false

# --- Dashboard: Work Queue (left panel) ---
# Whole panel
# VITE_FF_ENABLE_WORK_QUEUE=false

# --- Dashboard: Ticket detail (center) ---
# Whole panel
# VITE_FF_ENABLE_TICKET_DETAIL=false

# --- Dashboard: Superpowers (right panel) ---
# Whole panel
# VITE_FF_ENABLE_SUPERPOWERS=false
# Client tab
# VITE_FF_ENABLE_CLIENT_TAB=false
# Assistant tab
# VITE_FF_ENABLE_ASSISTANT_TAB=false
# Assistant tab, server side (also needed)
# FEATURE_FLAG_ENABLE_TICKET_ASSISTANT=false
# Notes tab (also needs the internal-notes flag)
# VITE_FF_ENABLE_NOTES_TAB=false
# All internal-notes UI: reply mode, thread cards, mentions
# VITE_FF_ENABLE_INTERNAL_NOTES=false
# Escalation tab
# VITE_FF_ENABLE_ESCALATE_TAB=false
# Similar tab
# VITE_FF_ENABLE_SIMILAR_TAB=false
# Articles tab
# VITE_FF_ENABLE_ARTICLES_TAB=false
# Tab order, comma-separated ids; unlisted tabs follow in this order
# VITE_FF_RIGHT_PANEL_TAB_ORDER=client,assistant,notes,escalate,similar,articles

# --- Dashboard: other screens ---
# Select and group similar tickets in the list
# VITE_FF_ENABLE_TICKET_GROUPING=false
# "Assign to me" in the ticket header
# VITE_FF_ENABLE_ASSIGN_TO_ME=false
# Earlier related tickets drawer
# VITE_FF_ENABLE_RELATED_HISTORY_DRAWER=false
# Contact detail drawer in Clients
# VITE_FF_ENABLE_CONTACT_DETAIL_DRAWER=false

# --- Dashboard: polling (seconds) ---
# Sidebar counts
# VITE_FF_SIDEBAR_COUNTS_POLL_INTERVAL_SECONDS=120
# Notes counts
# VITE_FF_NOTE_COUNTS_POLL_INTERVAL_SECONDS=30
# Notifications
# VITE_FF_NOTIFICATIONS_POLL_INTERVAL_SECONDS=30

# Vercel build variable, not read by the app: set it on the kairo-api project, or its Hono build fails type-checking.
VERCEL_EXPERIMENTAL_BACKENDS=1

# === LANDING (apps/landing) ======================================
# Validated by apps/landing/env.ts via @t3-oss/env-nextjs

# Supabase public vars (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Google OAuth client ID (safe to expose to the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Base URL of the landing/auth app (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where to send users after login — /dashboard in prod, Vite URL in dev
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173/dashboard/

# KAI-126/KAI-189: ClickStack (OpenTelemetry) browser tracing. Unset -> disabled.
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === KELAN (apps/kelan) ============================================
# Validated by apps/kelan/env.ts via @t3-oss/env-nextjs

# Supabase public vars (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — base URL of the kelan app itself
# NEXT_PUBLIC_KELAN_URL=http://localhost:3002

# KAI-126/KAI-189: ClickStack (OpenTelemetry) browser tracing. Unset -> disabled.
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === DASHBOARD (apps/dashboard) ===================================
# Validated by apps/dashboard/src/env.ts via @t3-oss/env-core

# Supabase public vars (Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Landing URL for cross-app redirects — empty in prod (same origin)
VITE_LANDING_URL=http://localhost:3000

# Origins serving /api/* and /bff/* — empty = same origin as the app (web build).
# A host that is not the landing origin (desktop shell, standalone hosting) sets both.
VITE_API_BASE_URL=
VITE_BFF_BASE_URL=

# KAI-126: ClickStack (OpenTelemetry) browser tracing (docker-compose.observability.yml).
# Unset -> disabled, no fetch instrumentation registered.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VITE_OTEL_SERVICE_NAME=kairo-dashboard

# === MOBILE (apps/mobile) ==========================================
# No @t3-oss/env setup yet (app is a placeholder) — read via process.env
# directly, using Expo's own EXPO_PUBLIC_* convention for build-time-inlined
# client vars, not this repo's usual env.ts pattern.

# KAI-126: mobile OTel tracing (manual spans only, no auto-instrumentation —
# see packages/observability/src/mobile.ts). Unset -> disabled.
EXPO_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
