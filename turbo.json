{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": ["FEATURE_FLAG_LOCAL_SUPABASE", "LOCAL_SUPABASE_URL", "LOCAL_SUPABASE_ANON_KEY", "LOCAL_SUPABASE_SERVICE_ROLE_KEY", "FEATURE_FLAG_ENABLE_DETECTION_UI", "INNGEST_DEV", "API_ORIGIN", "VERCEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/env/**"],
      "outputs": ["dist/**", ".next/**", "out/**", "public/dashboard/**", "!.next/cache/**"]
    },
    "build:api": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/env/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", "../../packages/env/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@kairo/dashboard#build": {
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_ANON_KEY"],
      "outputs": ["dist/**"]
    },
    "@kairo/landing#build": {
      "dependsOn": ["@kairo/dashboard#build"],
      "env": ["GOOGLE_CLIENT_SECRET", "SUPABASE_SERVICE_ROLE_KEY", "API_ORIGIN"],
      "outputs": [".next/**", "!.next/cache/**", "public/dashboard/**"]
    }
  }
}
